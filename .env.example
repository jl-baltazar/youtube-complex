# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ─── Media ───────────────────────────────────────────────────────────────────
# Host path to the media directory, mounted as /media/youtube inside the container.
# Windows examples (Docker Desktop / WSL2):
#   MEDIA_PATH=Z:/youtube                   (mapped drive, forward slashes)
#   MEDIA_PATH=//192.168.1.130/USB_TOSHIBA_EXTERNAL_USB_a_2/youtube  (UNC)
MEDIA_PATH=Z:/youtube

# ─── Plex ────────────────────────────────────────────────────────────────────
PLEX_URL=http://192.168.1.78:32400
PLEX_TOKEN=your_plex_token_here
PLEX_SECTION=9

# Path to the media folder as Plex sees it (Windows path on the Plex host).
# Used to map Plex-returned file paths back to the local container path.
PLEX_MEDIA_PREFIX=Z:\youtube

# ─── Proxy ───────────────────────────────────────────────────────────────────
# Port exposed by the on-demand stream proxy (Plex webhook receiver).
PROXY_PORT=9090
